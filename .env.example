# Copy this file to ".env" and fill in your real token.
TELEGRAM_BOT_TOKEN=

GOOGLE_SHEET_ID=

# Tab names: the Activity Log (one row per activity) and the second tab
# (one row per project).
ACTIVITY_TAB=Activity Log
PROJECTS_TAB=Projects
# Activity Log categories the agent may use, comma-separated.
CATEGORIES=Networking,Outreach,Project,Meeting,Learning,Personal Brand,Preparation

# Claude API key (see TODO.md: to be replaced by identity federation before GitHub Actions)
ANTHROPIC_API_KEY=
# Claude model the agent uses
CLAUDE_MODEL=claude-haiku-5-5

# Your own Telegram chat ID. The bot ignores messages from every other chat.
TELEGRAM_CHAT_ID=

# Test copy of the Sheet. The agent writes here while SHEET_TARGET=test.
GOOGLE_TEST_SHEET_ID=
# Which Sheet the agent reads and writes: "test" or "real".
SHEET_TARGET=test

# Google Calendar read as a second source (shared with the service account).
GOOGLE_CALENDAR_ID=
# "on" runs the calendar check at bot start and then every hour.
CALENDAR_SYNC=
